class Object
  def load_file: (String file) -> untyped

  def load_yaml: (String file) -> untyped

  def save_yaml: (String file, hash[untyped, untyped] data) -> untyped

  def shell_cmd: (String cmd) -> untyped

  def reload?: (?print: bool) -> bool

  def retain?: (String file, hash[untyped, untyped] data, ?print: bool) -> bool

  def system?: (Array[String] args1, Array[String]? args2, ?print: bool) -> bool

  def upload!: (String file, ?print: bool) -> untyped
end
