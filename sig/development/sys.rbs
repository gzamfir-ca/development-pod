class Object
  def load_file: (String file) -> bool

  def load_yaml: (String file) -> untyped

  def save_yaml: (String file, hash[String, String | array[hash[String, String]]] data) -> bool

  def shell_cmd: (String cmd) -> int

  def reload?: (?print: bool) -> bool

  def retain?: (String file, hash[String, String | array[hash[String, String]]] data, ?print: bool) -> bool

  def system?: (Array[String] args1, Array[String]? args2, ?print: bool) -> bool

  def upload!: (String file, ?print: bool) -> untyped
end
