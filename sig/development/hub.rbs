module Development
  module Hub
    def append_options: (Array[String] tool, ?sep: String) -> untyped

    def copy_item?: (Pathname src, Pathname dest) -> bool

    def filter_file?: (Pathname file, array[String] patterns) -> bool

    def git_init?: -> bool

    def move_item?: (Pathname src, Pathname dest) -> bool

    def run_pipeline?: (Pathname path, array[array[String]] tools) -> bool

    def run_tools?: (Pathname path, array[array[String]] tools) -> bool

    def setup_core?: -> bool

    def token_gsub?: (Pathname file, String original, String replacement) -> bool

    def update_file?: (Pathname file, String mode, String data) -> bool

    def update_options?: -> bool

    private

    def log_exception: (Symbol | nil method_name, String message, StandardError exp) -> untyped
  end
end
