    ECHO_FILE: String
    BACK_COLOR: String
    FAIL_COLOR: String
    PASS_COLOR: String
    THEN_COLOR: String
    FAIL_MSG: String
    THEN_MSG: String
    VERSION: String

    def safe_remove: -> bool

    def append_options: (Array[String] tool, ?sep: String) -> untyped

    def copy_item: (String src_dir, String dest_dir) -> bool

